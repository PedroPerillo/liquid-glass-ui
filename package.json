{
  "name": "liquid-glass-ui",
  "version": "0.1.0",
  "description": "Apple-style Liquid Glass components for the web: tab bar, segmented control, toolbar, sheet, toast and more, with real refraction in Chromium and graceful fallbacks.",
  "type": "module",
  "main": "src/liquid-glass.js",
  "module": "src/liquid-glass.js",
  "types": "types/liquid-glass.d.ts",
  "exports": {
    ".": {
      "types": "./types/liquid-glass.d.ts",
      "default": "./src/liquid-glass.js"
    },
    "./style.css": "./src/liquid-glass.css"
  },
  "files": ["src", "types"],
  "sideEffects": ["./src/liquid-glass.css", "./src/liquid-glass.js"],
  "scripts": {
    "dev": "npx --yes serve . -l 5173"
  },
  "keywords": ["liquid glass", "glassmorphism", "ios 26", "web components", "tab bar", "backdrop-filter"],
  "author": "Pedro Perillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroPerillo/liquid-glass-ui.git"
  }
}
