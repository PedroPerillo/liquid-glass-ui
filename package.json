{
  "name": "liquid-glass-ui",
  "version": "0.2.0",
  "description": "Apple-style Liquid Glass and Liquid Metal components for the web, plus mesh gradient backgrounds. Real refraction in Chromium, graceful fallbacks everywhere.",
  "type": "module",
  "main": "src/liquid-glass.js",
  "module": "src/liquid-glass.js",
  "types": "types/liquid-glass.d.ts",
  "exports": {
    ".": {
      "types": "./types/liquid-glass.d.ts",
      "default": "./src/liquid-glass.js"
    },
    "./style.css": "./src/liquid-glass.css",
    "./metal": {
      "types": "./types/liquid-metal.d.ts",
      "default": "./src/liquid-metal.js"
    },
    "./metal.css": "./src/liquid-metal.css",
    "./gradients.css": "./src/gradients.css"
  },
  "files": [
    "src",
    "types"
  ],
  "sideEffects": [
    "./src/*.css",
    "./src/*.js"
  ],
  "scripts": {
    "dev": "npx --yes serve . -l 5173"
  },
  "keywords": [
    "liquid glass",
    "glassmorphism",
    "ios 26",
    "web components",
    "tab bar",
    "backdrop-filter",
    "liquid metal",
    "chrome",
    "mesh gradient"
  ],
  "author": "Pedro Perillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroPerillo/liquid-glass-ui.git"
  }
}
